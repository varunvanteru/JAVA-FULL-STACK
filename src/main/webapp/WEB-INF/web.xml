<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         id="WebApp_ID" version="6.0">

    <display-name>CodeQuest</display-name>

    <!-- ===== ServletContext parameters (shared by the WHOLE application) ===== -->
    <context-param>
        <param-name>appName</param-name>
        <param-value>CodeQuest</param-value>
    </context-param>
    <context-param>
        <param-name>xpPerLevel</param-name>
        <param-value>100</param-value>
    </context-param>

    <!-- Servlets are mapped with @WebServlet annotations.
         Servlet-specific ServletConfig values are given with @WebInitParam
         in AdminLoginServlet and AddQuestionServlet. -->

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>
</web-app>
